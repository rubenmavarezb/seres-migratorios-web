# Variables de entorno públicas del sitio (PLAN.md §14).
#
# Este archivo se versiona y solo lleva placeholders: los valores reales van en
# el panel de Netlify (Site configuration > Environment variables) y, para
# desarrollo local, en un .env propio que NO se commitea (está en .gitignore).
# Copiar con: cp .env.example .env
#
# Todas llevan el prefijo PUBLIC_ porque se leen desde el cliente
# (import.meta.env.PUBLIC_*). Las variables privadas de v2 (RESEND_API_KEY,
# SUPABASE_*) no van acá: se leerán con astro:env/server.

# URL canónica del sitio. La usa astro.config.mjs para `site` (y de ahí salen el
# sitemap, los canonical y los hreflang), así que tiene que ser una URL válida:
# un placeholder entre corchetes rompe el build.
# En SM-064, al conectar el dominio propio, reemplazar por https://[DOMINIO].
PUBLIC_SITE_URL=https://seres-migratorios.netlify.app

# Token del beacon de Cloudflare Web Analytics (PLAN.md §4.3, "Analytics").
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=[TOKEN CLOUDFLARE ANALYTICS]

# Perfil de Instagram del colectivo.
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/seresmigratorios/

# Correo de contacto que se muestra en el pie y en la página de apoyo.
PUBLIC_EMAIL_CONTACTO=[EMAIL DEL COLECTIVO]

# Links de donación de la página de apoyo.
PUBLIC_LINK_MERCADOPAGO=[LINK MERCADO PAGO]
PUBLIC_LINK_PAYPAL=[LINK PAYPAL]
PUBLIC_LINK_CAFECITO=[LINK CAFECITO]

# El formulario de convocatoria no necesita variable: Netlify Forms se activa
# con atributos en el HTML, no con un endpoint.
