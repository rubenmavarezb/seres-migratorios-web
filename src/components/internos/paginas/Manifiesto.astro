---
/**
 * Manifiesto — shared body of `/manifiesto` and `/en/manifesto` (SM-035,
 * SM-048). Both routes are thin wrappers that only fix `idioma`; everything
 * below — frontmatter and markup — is the page as SM-035 built it.
 *
 * Internal helper, not a canonical component of design-system.md §7, hence
 * `components/internos/` (CLAUDE.md, "los helpers ajenos al design system van
 * en internos/"). It takes `idioma` as a prop instead of reading
 * `Astro.currentLocale` so a route is the single place that decides its
 * language, and every `t()` call and `rutaLocalizada()` here follows from it.
 *
 * Built to match `design/Manifiesto.dc.html`, which wins over `sitemap.md`
 * wherever they differ.
 *
 * Uses `Pagina.astro` with the `encabezado` PROP (the standard `display-lg`
 * `<h1>` "Manifiesto"), per the lámina and this ticket's brief — not a
 * `TitularPartido`/`Escudo` header as the older sitemap wireframe described.
 * `contenedor={false}` because the page builds its own `<section>` blocks with
 * their own top rules and vertical rhythm (same pattern as /kit); a single
 * wrapping `.contenedor` would double the side padding.
 *
 * BLOCKS, top to bottom (lámina):
 *  1. Header (`Pagina` `encabezado`): the `<h1>` "Manifiesto".
 *  2. Cita: the official post quote as a `<blockquote>` (mono, 20px, 60ch) with
 *     the "Post del 31.07.2026" attribution. Reuses `home.manifiesto.cita` /
 *     `.atribucion` — the exact same approved literal shown on the home, kept as
 *     a single source rather than duplicated under `manifiesto.*`.
 *  3. "Cómo empezó": an `<h2>` and three numbered, dated steps (01/02/03, the
 *     number in mono azul-sello as a reading guide, not content). Each step: a
 *     `CajaNombre` chica with the date, two mono lines, and a `FotoPegada` with
 *     an author-credit caption.
 *  4. Cierre: `PalabrasClave` (the printed capa) + a `Boton` to edition 01.
 *
 * OBSERVACIONES (documented per CLAUDE.md):
 *  - `FotoPegada.astro` has no `pie`/caption prop (the lámina's `x-import`
 *    passes `pie="Herick Frontado"`). Placement/caption belong to the caller
 *    (diseno-web-indice.md decision 13), so each photo is wrapped in a
 *    `<figure>` and the caption added as a `<figcaption>`. The caption is the
 *    author credit (the lámina's NOTA: "el pie es el crédito, no el título"),
 *    taken from the `artistas` collection `nombre` (single source of truth),
 *    not hardcoded.
 *  - The step photos' `alt` come from the `artistas` collection, where they are
 *    still visible placeholders ("[DESCRIPCIÓN DE LA IMAGEN NN]"); shown as-is,
 *    never invented.
 *  - `botones.verLaEdicion` is "Ver la edición"; the lámina's button reads "Ver
 *    la edición 01", so the label lives in `manifiesto.cierre.boton`.
 *  - The lámina shows no reel URL anywhere on /manifiesto, so there is no reel
 *    link and no placeholder for one (nothing to render).
 *  - `manifiesto.pasos.*`, `manifiesto.cierre.boton`, `home.manifiesto.cita`
 *    and `.atribucion` are still `[EN PENDIENTE]` in `en.json`, so
 *    `/en/manifesto` shows those placeholders. That is the real state of the
 *    content (SM-051 is Ruben's); translating them here is out of scope.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

import Boton from '../../Boton.astro';
import CajaNombre from '../../CajaNombre.astro';
import FotoPegada from '../../FotoPegada.astro';
import PalabrasClave from '../../PalabrasClave.astro';
import palabrasClaveImagen from '../../../assets/marca/palabras-clave.png';
import Pagina from '../../../layouts/Pagina.astro';
import { type Idioma, rutaLocalizada, t } from '../../../i18n/utils.ts';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;

const artistas = await getCollection('artistas');
const artistasPorId = new Map(artistas.map((entrada) => [entrada.id, entrada]));

/**
 * The three "Cómo empezó" steps, in the lámina's order. Each pairs a dictionary
 * subtree (`manifiesto.pasos.*`) with the obra photo the lámina uses and its
 * rotation. The caption is the author's `nombre` from the collection.
 */
const PASOS = [
  { clave: 'uno', artistaId: 'herick-frontado', obraIndice: 1, rotacion: -2 },
  { clave: 'dos', artistaId: 'leo-simmons', obraIndice: 0, rotacion: 2 },
  { clave: 'tres', artistaId: 'carlos-vazquez', obraIndice: 0, rotacion: -1 },
] as const;

const pasos = PASOS.map((paso, indice) => {
  const artista = artistasPorId.get(paso.artistaId);
  if (artista === undefined || artista.data.obra.length <= paso.obraIndice) {
    throw new Error(`/manifiesto necesita la obra de ${paso.artistaId}.`);
  }
  return {
    numero: String(indice + 1).padStart(2, '0'),
    caja: t(idioma, `manifiesto.pasos.${paso.clave}.caja` as const),
    linea1: t(idioma, `manifiesto.pasos.${paso.clave}.linea1` as const),
    linea2: t(idioma, `manifiesto.pasos.${paso.clave}.linea2` as const),
    obra: artista.data.obra[paso.obraIndice] as CollectionEntry<'artistas'>['data']['obra'][number],
    obraAlt: artista.data.obra[paso.obraIndice].alt[idioma],
    credito: artista.data.nombre,
    rotacion: paso.rotacion,
  };
});

const rutaEdicion01 = rutaLocalizada('/ediciones/buenos-aires-2026', idioma);

// Shared section chrome, same convention as the home.
const CLASE_BANDA = 'border-t border-linea';
const CLASE_CONTENEDOR = 'mx-auto w-full max-w-[1280px] px-6 md:px-12';
const CLASE_LINEA_MONO = 'font-mono text-tinta m-0 max-w-[65ch] leading-relaxed text-pretty';
---

<Pagina
  titulo={t(idioma, 'manifiesto.titulo')}
  descripcion={t(idioma, 'seo.descripcionPorDefecto')}
  idioma={idioma}
  rutaActual={Astro.url.pathname}
  contenedor={false}
  encabezado={{ titulo: t(idioma, 'manifiesto.titulo') }}
>
  {/* ============ 2 · CITA ============ */}
  <section>
    <div
      class={`${CLASE_CONTENEDOR} grid grid-cols-1 gap-6 pb-12 md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] md:pb-20`}
    >
      <div class="flex flex-col items-start gap-6 md:col-start-2">
        <blockquote
          class="font-mono text-tinta m-0 max-w-[60ch] text-[20px] leading-relaxed text-pretty"
        >
          {t(idioma, 'home.manifiesto.cita')}
        </blockquote>
        <p class="font-mono text-etiqueta text-grafito m-0 font-bold uppercase">
          {t(idioma, 'home.manifiesto.atribucion')}
        </p>
      </div>
    </div>
  </section>

  {/* ============ 3 · CÓMO EMPEZÓ ============ */}
  <section class={CLASE_BANDA}>
    <div class={`${CLASE_CONTENEDOR} flex flex-col gap-12 py-12 md:gap-16 md:py-16`}>
      <h2 class="font-display text-display-md text-tinta m-0 uppercase">
        {t(idioma, 'manifiesto.comoEmpezo')}
      </h2>
      {
        pasos.map((paso) => (
          <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,5fr)] items-start gap-4 md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] md:gap-6">
            <p class="font-mono text-etiqueta text-azul-sello m-0 font-bold uppercase">
              {paso.numero}
            </p>
            <div class="flex flex-col items-start gap-4 md:gap-6">
              <CajaNombre texto={paso.caja} tamano="chica" />
              <div class="flex flex-col gap-2">
                <p class={CLASE_LINEA_MONO}>{paso.linea1}</p>
                <p class={CLASE_LINEA_MONO}>{paso.linea2}</p>
              </div>
              <figure class="m-0 flex max-w-[420px] flex-col gap-2 pl-2">
                <FotoPegada
                  imagen={paso.obra.image}
                  alt={paso.obraAlt}
                  rotacion={paso.rotacion}
                  widths={[240, 420, 480]}
                  sizes="(min-width: 768px) 420px, 100vw"
                />
                <figcaption class="font-mono text-metadatos text-grafito">
                  {paso.credito}
                </figcaption>
              </figure>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* ============ 4 · CIERRE ============ */}
  <section class={CLASE_BANDA}>
    <div
      class={`${CLASE_CONTENEDOR} flex flex-col items-center gap-12 py-12 pb-16 md:py-16 md:pb-24`}
    >
      <div class="w-full max-w-[376px]">
        <PalabrasClave imagen={palabrasClaveImagen} />
      </div>
      <div class="w-full md:w-auto">
        <Boton href={rutaEdicion01} anchoCompletoMobile>
          {t(idioma, 'manifiesto.cierre.boton')}
        </Boton>
      </div>
    </div>
  </section>
</Pagina>
