---
/**
 * Seo — the single source of every metadata tag of the site (PLAN.md §10,
 * backlog SM-033): `<title>`, description, canonical, Open Graph and Twitter
 * Card. `Base.astro`'s `<head>` renders this component instead of writing any
 * of those tags itself, so a page never emits a second `<title>` or a
 * competing `og:*` pair — that is what "única fuente" means here, and it is
 * verified in the built HTML (see this ticket's report).
 *
 * Internal helper, not a canonical component of design-system.md §7, hence
 * `components/internos/` (CLAUDE.md, "los helpers ajenos al design system van
 * en internos/").
 *
 * `titulo` composition is the rule SM-012 established and this component
 * inherits verbatim: `titulo` + `seo.separador` + `seo.tituloSitio`, except on
 * the page whose title already IS the site title (the home), which would
 * otherwise read "Seres Migratorios · Seres Migratorios".
 *
 * Canonical and `og:url` are the same absolute URL, built with
 * `new URL(rutaActual, Astro.site)` — `Astro.site` is the `site` of
 * astro.config.mjs, which reads `PUBLIC_SITE_URL` and falls back to
 * `https://seresmigratorios.com` (SM-010/SM-064; the internal
 * seres-migratorios.netlify.app URL is never used for canonicals).
 * `rutaActual` defaults, in `Base.astro`, to `Astro.url.pathname`, so a page
 * gets the right canonical without passing anything; a page that needs to
 * point elsewhere (a future paginated route, for instance) can override it.
 *
 * [OG DE MARCA PENDIENTE — SM-062] There is no brand Open Graph image yet, so
 * a page without `imagenOg` emits NO `og:image` and NO `twitter:image` at all,
 * rather than pointing at a file that does not exist — the behaviour
 * `Base.astro` documented before this component existed, kept as-is. When
 * SM-062 exports `src/assets/marca/og-seres-migratorios.png` (1200×630,
 * PLAN.md §10), the fallback goes in `Base.astro`, where the import lives:
 * uncomment its `ogDeMarca` import and pass `imagenOg={imagenOg ?? ogDeMarca}`.
 * Nothing in this component changes. `twitter:card` follows from the same
 * condition: `summary_large_image` when there is an image, `summary` when
 * there is not (a `summary_large_image` card with no image renders as a bare
 * text card anyway).
 *
 * `og:locale` is `es_AR` / `en_US`, the same pair `@astrojs/sitemap` is
 * configured with in astro.config.mjs.
 *
 * OBSERVACIÓN (`theme-color`): still not emitted, and now for good. Its
 * `content` attribute takes a literal color, and an HTML attribute cannot read
 * a CSS custom property or a Tailwind token, so the value would have to be the
 * hexadecimal of `--color-papel` written into a `.astro` file — exactly what
 * CLAUDE.md forbids outside the `@theme` of src/styles/theme.css. The tag is
 * cosmetic (it tints browser UI on some mobile browsers) and nothing in the
 * approved design asks for it. If Ruben wants it, the clean way is a `<style>`
 * in the layout plus `<meta name="theme-color">` fed from a token by a build
 * step, or a documented exception to the no-hex rule — a decision, not a
 * detail.
 *
 * NOT here, on purpose: the `hreflang` pair is SM-049/SM-050 (it needs both
 * language URLs of the current route, which `i18n/rutas.ts` already computes
 * with `rutasAlternativas()`), the Cloudflare Web Analytics beacon is SM-065,
 * and the `<link rel="preconnect">` hints stay in `Base.astro` — they are
 * resource hints, not metadata.
 */
import type { ImageMetadata } from 'astro';

import { type Idioma, t } from '../../i18n/utils.ts';

interface Props {
  /** Page title, without the site name: this component appends it. */
  titulo: string;
  /** Page description, used for `<meta name="description">`, `og:description` and `twitter:description`. */
  descripcion: string;
  /** Per-page Open Graph image. Without it, no `og:image`/`twitter:image` is emitted — see the SM-062 note above. */
  imagenOg?: ImageMetadata;
  idioma: Idioma;
  /** Path the canonical URL is built from, e.g. `/en/artists/herick-frontado`. `Base.astro` passes `Astro.url.pathname` when the page does not override it. */
  rutaActual: string;
  /** Emits `<meta name="robots" content="noindex">` for an internal page (`/kit`, SM-029). */
  noindex?: boolean;
}

const { titulo, descripcion, imagenOg, idioma, rutaActual, noindex = false } = Astro.props;

/** Open Graph locale codes, same pair as `@astrojs/sitemap`'s `i18n.locales`. */
const LOCALES_OG: Readonly<Record<Idioma, string>> = { es: 'es_AR', en: 'en_US' };

const tituloSitio = t(idioma, 'seo.tituloSitio');
const tituloCompleto =
  titulo === tituloSitio ? tituloSitio : `${titulo} ${t(idioma, 'seo.separador')} ${tituloSitio}`;

const urlCanonica = new URL(rutaActual, Astro.site).href;
const urlImagenOg = imagenOg === undefined ? undefined : new URL(imagenOg.src, Astro.site).href;
const tipoDeTarjeta = urlImagenOg === undefined ? 'summary' : 'summary_large_image';
---

<title>{tituloCompleto}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={urlCanonica} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={urlCanonica} />
<meta property="og:locale" content={LOCALES_OG[idioma]} />
{urlImagenOg !== undefined && <meta property="og:image" content={urlImagenOg} />}
<meta name="twitter:card" content={tipoDeTarjeta} />
<meta name="twitter:title" content={tituloCompleto} />
<meta name="twitter:description" content={descripcion} />
{urlImagenOg !== undefined && <meta name="twitter:image" content={urlImagenOg} />}
