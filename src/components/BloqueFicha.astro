---
/**
 * BloqueFicha (design-system.md §7.1): expediente header with three mono
 * columns — FECHA: / HORARIOS: / LUGAR: — each with its value below,
 * collapsing to a single column on mobile.
 *
 * Spec source: design/ds/components/expediente/BloqueFicha.jsx, the component
 * every page lámina renders (Home hero and próxima edición, Ediciones, Edición
 * 01): label and value share one style — the etiqueta role at 14px, 700,
 * uppercase, 0.04em, line-height 1.35, no space between them — with a 24px
 * gap between the three groups and no rule above the block. Until the QA
 * visual de Fase 2 (R06) this file followed design/ds/canvas/Componentes.dc.html
 * "01 · BLOQUEFICHA" instead (13px labels, 14px plain values, 20px gap and a
 * 1px `linea` rule on top for the "papel" variant), which none of the page
 * láminas draws; the page lámina wins. Values arrive already formatted by the
 * caller (e.g. "08.08.2026", "10:00 AM – 19:00"): this component never
 * formats dates or times itself.
 *
 * Placement (grid position, margins, container rotation) is the caller's
 * job — this component accepts no position classes, per diseno-web-indice.md
 * decision 13.
 *
 * Every value renders through `uppercase` (text-transform), never baked-in
 * caps, so the caller can always pass real-case content (CLAUDE.md, "Mayúsculas
 * solo con text-transform") — labels stay legible in source and LUGAR's three
 * lines still render capitalized as in the lamina.
 */
import { t, type Idioma } from '../i18n/utils.ts';

interface Props {
  fecha: string;
  horario: string;
  lugar: {
    nombre: string;
    direccion: string;
    ciudad: string;
  };
  variante?: 'papel' | 'caja';
  idioma?: Idioma;
}

const { fecha, horario, lugar, variante = 'papel', idioma } = Astro.props;

// Falls back to Astro.currentLocale (typed 'string | undefined' by Astro
// itself), narrowed to the two locales this site supports.
const idiomaActual: Idioma = idioma ?? (Astro.currentLocale === 'en' ? 'en' : 'es');

// "En papel" (default): the bare block the page láminas draw, nothing around
// it. "En caja": a 2px ink border with a pure-white fill, for use over a photo
// or a colored section (design/ds/canvas/Componentes.dc.html, "01 · BLOQUEFICHA").
const clasesVariante =
  variante === 'caja' ? 'border-2 border-tinta bg-papel-puro px-[22px] py-5' : undefined;

// "Papel": one style for label and value (BloqueFicha.jsx `etiqueta` /
// `valor`): `text-etiqueta` brings the 14px and the 0.04em of the role,
// `leading-[1.35]` the line-height the JSX fixes on both, no gap between them,
// 24px between the groups. "Caja" keeps the spec of Componentes.dc.html
// "01 · BLOQUEFICHA" it was built from (13px labels, 14px plain values, 6px
// between them, 20px between the groups), with the role's letter-spacing on
// the label instead of `tracking-wide`.
const esCaja = variante === 'caja';
const CLASE_LINEA_PAPEL = 'font-mono text-etiqueta font-bold uppercase leading-[1.35]';
const CLASE_ETIQUETA_CAJA =
  'font-mono text-metadatos font-bold uppercase tracking-(--text-etiqueta--letter-spacing)';
const CLASE_VALOR_CAJA = 'font-mono text-[0.875rem] font-normal uppercase';
const claseEtiqueta = esCaja ? CLASE_ETIQUETA_CAJA : CLASE_LINEA_PAPEL;
const claseValor = esCaja ? CLASE_VALOR_CAJA : CLASE_LINEA_PAPEL;
const claseGrupo = esCaja ? 'flex flex-col gap-1.5' : 'flex flex-col';
---

<dl
  class:list={[
    'grid grid-cols-1 text-tinta md:grid-cols-3',
    esCaja ? 'gap-5' : 'gap-6',
    clasesVariante,
  ]}
>
  <div class={claseGrupo}>
    <dt class={claseEtiqueta}>{t(idiomaActual, 'ficha.fecha')}</dt>
    <dd class={claseValor}>{fecha}</dd>
  </div>
  <div class={claseGrupo}>
    <dt class={claseEtiqueta}>{t(idiomaActual, 'ficha.horarios')}</dt>
    <dd class={claseValor}>{horario}</dd>
  </div>
  <div class={claseGrupo}>
    <dt class={claseEtiqueta}>{t(idiomaActual, 'ficha.lugar')}</dt>
    <dd class:list={[claseValor, esCaja && 'leading-normal']}>
      {lugar.nombre}<br />
      {lugar.direccion}<br />
      {lugar.ciudad}
    </dd>
  </div>
</dl>
