          <Boton>{t(idioma, 'botones.verTodosLosArtistas')}</Boton>
        </div>
      </div>
      <div class={CLASE_EJEMPLO}>
        <p class={CLASE_RUBRO}>variante="sello" · con href y sin href</p>
