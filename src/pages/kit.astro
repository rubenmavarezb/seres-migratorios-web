      </div>
    </div>
  </section>

  <!-- 09 · SelloHorario -->
  <section id="sellohorario" class={CLASE_SECCION}>
    <div class={CLASE_ENCABEZADO}>
      <h2 class={CLASE_TITULO}>SelloHorario</h2>
      <span class={CLASE_REGLA}></span>
      <span class={CLASE_INDICE}>09</span>
    </div>
    {
      edicion.data.selloHorario === undefined ? (
        <p class={CLASE_NOTA}>{t(idioma, 'estados.aConfirmar')}</p>
      ) : (
        <div class={CLASE_EJEMPLOS}>
          <div class={CLASE_EJEMPLO}>
            <p class={CLASE_RUBRO}>apilado (por defecto) · tamano 64</p>
            <SelloHorario
              desde={edicion.data.selloHorario.desde}
              hasta={edicion.data.selloHorario.hasta}
              fechaCorta={edicion.data.selloHorario.fechaCorta}
              idioma={idioma}
            />
          </div>
          <div class={CLASE_EJEMPLO}>
            <p class={CLASE_RUBRO}>{'apilado={false} · tamano 48'}</p>
            <SelloHorario
              desde={edicion.data.selloHorario.desde}
              hasta={edicion.data.selloHorario.hasta}
              fechaCorta={edicion.data.selloHorario.fechaCorta}
              tamano={48}
              apilado={false}
              idioma={idioma}
            />
          </div>
          <div class={CLASE_EJEMPLO}>
            <p class={CLASE_RUBRO}>imagen sello-horario.png + imagenFecha fecha-corta-8-8-26.png</p>
