            nombre={naia.data.nombre}
            obraPrincipal={obraNaia.image}
            obraAlt={obraNaia.alt[idioma]}
            retratoAlt={naia.data.retratoAlt[idioma]}
            retratoTamano={[72, 72]}
            frase={naia.data.frase[idioma]}
