---
/**
 * Single test page of Fase 1 (SM-012, updated in SM-013): it proves
 * `Base.astro` mounts `<html lang>`, the head, the paper background, `Nav` and
 * `Pie`, that `Pagina.astro` adds the header and the 1280 px container on top
 * of it, and that `/` is served as the unprefixed default locale. The real
 * home page, with the eight blocks of sitemap.md §2.1 and the `TitularPartido`
 * hero, lands in SM-034 and replaces this file.
 *
 * `idioma` is not passed to `Pagina` on purpose: `Base` derives it from
 * `Astro.currentLocale`, and this page is the check that it resolves to `es`.
 * `contenedor={false}` because there is no content under the header yet; a
 * `.contenedor` with nothing in it would only add an empty element.
 */
import Pagina from '../layouts/Pagina.astro';
import { type Idioma, t } from '../i18n/utils.ts';

/** This file only ever renders under the default locale. */
const idioma: Idioma = 'es';
---

<Pagina
  titulo={t(idioma, 'seo.tituloSitio')}
  descripcion={t(idioma, 'seo.descripcionPorDefecto')}
  rutaActual={Astro.url.pathname}
  encabezado={{
    titulo: t(idioma, 'seo.tituloSitio'),
    subtitulo: t(idioma, 'seo.descripcionPorDefecto'),
  }}
  contenedor={false}
/>
