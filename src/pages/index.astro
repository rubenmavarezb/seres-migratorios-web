---
/**
 * Single test page of Fase 1 (SM-012): it proves `Base.astro` mounts `<html
 * lang>`, the head, the paper background, `Nav` and `Pie`, and that `/` is
 * served as the unprefixed default locale. The real home page, with the eight
 * blocks of sitemap.md §2.1, lands in SM-034 and replaces this file.
 *
 * `idioma` is not passed to `Base` on purpose: the layout derives it from
 * `Astro.currentLocale`, and this page is the check that it resolves to `es`.
 */
import Base from '../layouts/Base.astro';
import { type Idioma, t } from '../i18n/utils.ts';

/** This file only ever renders under the default locale. */
const idioma: Idioma = 'es';
---

<Base
  titulo={t(idioma, 'seo.tituloSitio')}
  descripcion={t(idioma, 'seo.descripcionPorDefecto')}
  rutaActual={Astro.url.pathname}
>
  <div class="contenedor py-12 md:py-16">
    <h1 class="font-display text-display-lg uppercase">{t(idioma, 'seo.tituloSitio')}</h1>
  </div>
</Base>
