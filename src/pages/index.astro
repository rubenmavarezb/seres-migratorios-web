---
/**
 * `/` — home in Spanish, the default locale (SM-034). Its body — hero,
 * manifiesto, fotógrafos, exponen, próxima edición and cómo apoyar — lives in
 * `internos/paginas/Home.astro`, shared with `/en/` (SM-048); this file only
 * fixes the locale.
 */
import Home from '../components/internos/paginas/Home.astro';
import type { Idioma } from '../i18n/utils.ts';

/** The default locale carries no URL prefix; `/` only renders in Spanish. */
const idioma: Idioma = 'es';
---

<Home idioma={idioma} />
