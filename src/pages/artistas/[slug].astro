---
/**
 * `/artistas/[slug]` — one profile per entry of the `artistas` collection
 * (SM-037). Shared body in `internos/paginas/Artista.astro` (SM-048), where the
 * OBSERVACIONES of this page live; this file only resolves the entry and fixes
 * the locale.
 */
import { getCollection } from 'astro:content';

import PlantillaArtista from '../../components/internos/paginas/Artista.astro';
import type { Idioma } from '../../i18n/utils.ts';
import { publicados, type Artista } from '../../orden-artistas.ts';

export async function getStaticPaths() {
  const artistas = await getCollection('artistas');
  // Drafts get no page at all, the same way they get no row in the index.
  return publicados(artistas).map((artista) => ({
    params: { slug: artista.data.slug },
    props: { artista },
  }));
}

interface Props {
  artista: Artista;
}

/** This file only ever renders under the default (Spanish) locale. */
const idioma: Idioma = 'es';
const { artista } = Astro.props;
---

<PlantillaArtista idioma={idioma} artista={artista} />
