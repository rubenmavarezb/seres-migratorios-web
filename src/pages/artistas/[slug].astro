---
/**
 * `/artistas/[slug]` — one profile per entry of the `artistas` collection
 * (SM-037), for whoever shoots and whoever exhibits alike.
 *
 * OBSERVACIÓN (sitemap vs. lámina aprobada, same as `/artistas` — see the
 * header of `artistas/index.astro`). `sitemap.md` §2.4 lists seven blocks:
 * heading in mono 700, a big `FotoPegada` with the main work, quote and
 * signature, a mono `ETIQUETA:`/valor block with CIUDAD / INSTAGRAM /
 * EDICIONES, the gallery, previous/next as `CajaNombre`, and a final `Boton`
 * "VER TODOS LOS FOTÓGRAFOS". The design approved later that day
 * (`design/Artista.dc.html`, five screens: Herick and Rubén at 1440 and 390,
 * "Sin obra" at both, plus "Lightbox") shows: a "← Artistas" link, one
 * `CajaNombre` per role plus a linked one for the edition, the name as an
 * `<h1>` in display Anton, the handle, the bio, and — in the right column — the
 * portrait with the handwritten quote and signature under it; then the "Obra"
 * section as a collage, and previous/next as plain mono links. There is no
 * data block and no final `Boton` in any of the five screens. This page follows
 * the design; nothing of the backlog's acceptance criteria is lost:
 * - "los 7 bloques renderizan": every piece of information of those blocks is
 *   on the page. The city and country of the data block are the only value that
 *   the design drops — and today every entry but Herick and Rubén carries
 *   "[CIUDAD]" / "[PAÍS]" placeholders anyway. Instagram is the handle under
 *   the heading; the editions are the linked `CajaNombre`.
 * - "la navegación anterior/siguiente no se rompe en el primero ni en el
 *   último": it is cyclic, which is what the design asks for in writing
 *   ("cíclico") and shows in its own data — Herick, first of the index, links
 *   back to Gustavo Sánchez, its last entry. So the first has a previous and
 *   the last a next, and neither is an empty box or a broken link.
 *
 * OBSERVACIÓN (content vs. design): `ruben-mavarez.md` declares no `retrato`,
 * so his profile shows the dashed `[RETRATO]` placeholder even though
 * `src/assets/retratos/ruben-mavarez.jpg` exists and the approved screen uses
 * it; and his `obra` lists `01.png` / `02.png`, the two crops of the pieces,
 * while the design's collage uses the eight `web-01…08.jpg` (all of them
 * present in `src/assets/fotos/ruben-mavarez/`). Both are content fixes —
 * adding a field, reordering a list — and content is not this ticket's to
 * change, so the page renders what the collection says.
 */
import { getCollection, getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';

import placeholderRetrato from '../../assets/marca/placeholder-retrato.svg';
import Anotacion from '../../components/Anotacion.astro';
import CajaNombre from '../../components/CajaNombre.astro';
import Galeria from '../../components/internos/Galeria.astro';
import Lightbox from '../../components/internos/Lightbox.astro';
import { rutaLocalizada, t, type Idioma } from '../../i18n/utils.ts';
import Pagina from '../../layouts/Pagina.astro';
import {
  edicionDestacada,
  ordenDelIndice,
  publicados,
  vecinos,
  type Artista,
} from '../../orden-artistas.ts';

export async function getStaticPaths() {
  const artistas = await getCollection('artistas');
  // Drafts get no page at all, the same way they get no row in the index.
  return publicados(artistas).map((artista) => ({
    params: { slug: artista.data.slug },
    props: { artista },
  }));
}

interface Props {
  artista: Artista;
}

/** ES-only page: `/en/artists/[slug]` is Fase 3 (SM-051). */
const idioma: Idioma = 'es';

const { artista } = Astro.props;
const {
  numero,
  nombre,
  instagram,
  roles,
  retrato,
  retratoAlt,
  obra,
  frase,
  fraseManuscrita,
  firma,
} = artista.data;

/** Local stand-in for `t()`'s missing interpolation — same helper as `Sello.astro` and `FichaFotografo.astro`. */
function interpolar(plantilla: string, valores: Record<string, string>): string {
  return Object.entries(valores).reduce(
    (acumulado, [clave, valor]) => acumulado.replaceAll(`{${clave}}`, valor),
    plantilla
  );
}

/** A bracket placeholder is valid content but never a real value — same helper as `FichaFotografo.astro`. */
function esPlaceholder(valor: string | undefined): boolean {
  return valor === undefined || /^\[[^\]]+\]$/.test(valor);
}

/** "001 Herick Frontado", or just the name for whoever has no set number. */
function conNumero(entrada: Artista): string {
  const { numero: n, nombre: nombreEntrada } = entrada.data;
  return n === undefined ? nombreEntrada : `${n} ${nombreEntrada}`;
}

const titular = conNumero(artista);

// ---- Roles and edition ------------------------------------------------------
const etiquetasDeRol = roles.map((rol) =>
  rol === 'fotea' && numero !== undefined
    ? interpolar(t(idioma, 'artistas.rolConSet'), { rol: t(idioma, `roles.${rol}`), numero })
    : t(idioma, `roles.${rol}`)
);

const edicionesDelArtista = await getEntries(artista.data.ediciones);
const cajasDeEdicion = edicionesDelArtista.map((edicion) => ({
  texto: interpolar(t(idioma, 'artistas.cajaEdicion'), {
    edicion: edicion.data.nombre,
    anio: String(edicion.data.fecha.getUTCFullYear()),
  }),
  href: rutaLocalizada(`/ediciones/${edicion.data.slug}`, idioma),
}));

// ---- Portrait, quote, signature --------------------------------------------
// `placeholderRetrato`'s viewBox is 72×90, the same 0.8 ratio the design gives
// the dashed `[RETRATO]` box (260×325), so the fallback needs no special case
// here — exactly as in `FichaFotografo.astro`.
const imagenRetrato = retrato ?? placeholderRetrato;
const altRetrato = retrato
  ? retratoAlt.es
  : interpolar(t(idioma, 'ficha.retratoPendienteAlt'), { nombre });

// sitemap.md §3.3: with no scan, the quote is shown as text in font-manuscrita;
// with no real quote either (a bracket placeholder), the block is not rendered
// and the design's "[PENDIENTES]" line takes its place.
const fraseEsReal = !esPlaceholder(frase.es);
const mostrarFraseComoImagen = fraseManuscrita !== undefined;
const mostrarFraseComoTexto = fraseManuscrita === undefined && fraseEsReal;
const mostrarPendientes = !mostrarFraseComoImagen && !mostrarFraseComoTexto;

// The signature is decorative when the quote above already carries the
// transcription; on its own it is named, so its information is never silent.
const altFirma = mostrarFraseComoImagen ? '' : interpolar(t(idioma, 'ficha.firmaAlt'), { nombre });

// ---- Work -------------------------------------------------------------------
const fotos = obra.map((pieza) => ({
  imagen: pieza.image,
  alt: pieza.alt.es,
  titulo: pieza.titulo?.es,
}));

const grupoDeObra =
  numero === undefined
    ? t(idioma, 'artistas.obra.grupoExposicion')
    : interpolar(t(idioma, 'artistas.obra.grupoSet'), { numero });
const detalleDeObra =
  fotos.length === 1
    ? interpolar(t(idioma, 'artistas.obra.detalleUna'), { grupo: grupoDeObra })
    : interpolar(t(idioma, 'artistas.obra.detalle'), {
        grupo: grupoDeObra,
        cantidad: String(fotos.length),
      });

// ---- Previous / next --------------------------------------------------------
const todos = await getCollection('artistas');
const ediciones = await getCollection('ediciones');
const orden = ordenDelIndice(todos, edicionDestacada(ediciones));
const alrededor = vecinos(orden, artista.id);

const { Content } = await render(artista);

const handleEsReal = !esPlaceholder(instagram);
const descripcion = fraseEsReal ? frase.es : t(idioma, 'seo.descripcionPorDefecto');

// Class constants, so every element with a text child fits on one source line:
// with `compressHTML: true` a wrapped tag renders a literal space around its
// content (see the long OBSERVACIÓN in `FichaFotografo.astro`).
const CLASE_VOLVER =
  'inline-block py-3 font-mono text-etiqueta font-bold text-azul-sello uppercase underline underline-offset-[3px] transition-colors hover:text-azul-marcador focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azul-sello';
/** The design sets this `<h1>` at 6rem / 3.5rem, which is none of the three display tokens (`display-lg` is 7.5/3rem, `display-md` 3.5/2rem), so the two sizes are written as values, with the display scale's own line-height and letter-spacing. */
const CLASE_H1 =
  'font-display text-[3.5rem] leading-[0.85] tracking-[-0.01em] text-tinta uppercase text-balance md:text-[6rem]';
const CLASE_HANDLE_ENLACE =
  'inline-block py-2 font-mono text-base font-bold tracking-[0.04em] text-azul-sello underline underline-offset-4 transition-colors hover:text-azul-marcador focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azul-sello';
const CLASE_HANDLE_PENDIENTE =
  'inline-block py-2 font-mono text-base font-bold tracking-[0.04em] text-grafito';
const CLASE_BIO = 'flex max-w-[60ch] flex-col gap-4 font-mono text-base leading-[1.6] text-grafito';
const CLASE_DETALLE = 'font-mono text-etiqueta font-bold text-grafito uppercase';
const CLASE_PENDIENTES = 'font-mono text-metadatos text-grafito';
/** Empty state of the design: dashed 2px `linea` box, slightly rotated. `data-rotacion` is what `theme.css` cancels under `prefers-reduced-motion`, so the rotation goes inline next to it, never as a class. */
const CLASE_OBRA_VACIA =
  'grid h-[260px] place-items-center border-2 border-dashed border-linea font-mono text-etiqueta font-bold text-grafito md:h-[420px]';
const CLASE_NAV_ENLACE =
  'inline-block py-3 font-mono text-base font-bold text-azul-sello uppercase underline underline-offset-4 transition-colors hover:text-azul-marcador focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azul-sello';
---

<Pagina
  titulo={nombre}
  descripcion={descripcion}
  idioma={idioma}
  rutaActual={Astro.url.pathname}
  contenedor={false}
>
  <section
    class="contenedor grid grid-cols-1 gap-6 pt-6 pb-12 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-start md:gap-x-6 md:gap-y-12 md:pt-12 md:pb-16"
  >
    <div class="flex flex-col items-start gap-6">
      <a href={rutaLocalizada('/artistas', idioma)} class={CLASE_VOLVER}>
        {t(idioma, 'artistas.volver')}
      </a>

      {
        /* Two renders of the same chips, toggled by breakpoint, because
          `CajaNombre`'s `tamano` is a prop and cannot be responsive: the design
          uses the small size on mobile and the normal one on desktop. Same
          technique — and same reason — as `internos/Aparejo.astro`. */
      }
      <div class="flex flex-wrap gap-2 md:hidden">
        {etiquetasDeRol.map((etiqueta) => <CajaNombre texto={etiqueta} tamano="chica" />)}
        {
          cajasDeEdicion.map((caja) => (
            <CajaNombre texto={caja.texto} href={caja.href} tamano="chica" />
          ))
        }
      </div>
      <div class="hidden flex-wrap gap-3 md:flex">
        {etiquetasDeRol.map((etiqueta) => <CajaNombre texto={etiqueta} />)}
        {cajasDeEdicion.map((caja) => <CajaNombre texto={caja.texto} href={caja.href} />)}
      </div>

      <h1 class={CLASE_H1}>{titular}</h1>

      {
        handleEsReal && instagram !== undefined ? (
          <a href={`https://www.instagram.com/${instagram.slice(1)}/`} class={CLASE_HANDLE_ENLACE}>
            {instagram}
          </a>
        ) : (
          <span class={CLASE_HANDLE_PENDIENTE}>{t(idioma, 'artistas.handlePendiente')}</span>
        )
      }

      <div class={CLASE_BIO}><Content /></div>
    </div>

    <div
      class="grid grid-cols-[140px_minmax(0,1fr)] items-end gap-4 md:flex md:flex-col md:items-start md:gap-4 md:pt-16"
    >
      <Image
        src={imagenRetrato}
        alt={altRetrato}
        width={260}
        height={Math.round((260 * imagenRetrato.height) / imagenRetrato.width)}
        widths={[140, 260, 520].filter((ancho) => ancho <= imagenRetrato.width)}
        sizes="(min-width: 768px) 260px, 140px"
        loading="lazy"
        class="block h-auto w-[140px] md:w-[260px]"
      />
      <div class="flex flex-col gap-2 md:w-full">
        {
          mostrarFraseComoImagen && fraseManuscrita !== undefined && (
            <Anotacion imagen={fraseManuscrita} alt={frase.es} rotacion={-1} />
          )
        }
        {mostrarFraseComoTexto && <Anotacion texto={frase.es} rotacion={-1} />}
        {
          firma !== undefined && (
            <Image
              src={firma}
              alt={altFirma}
              aria-hidden={altFirma === '' ? 'true' : undefined}
              height={44}
              loading="lazy"
              class="block h-8 w-auto self-end md:h-11"
            />
          )
        }
        {
          mostrarPendientes && (
            <p class={CLASE_PENDIENTES}>{t(idioma, 'artistas.manuscritaPendiente')}</p>
          )
        }
      </div>
    </div>
  </section>

  <section id="obra" class="contenedor seccion flex flex-col gap-8 md:gap-12">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between md:gap-6">
      <h2 class="seccion-titulo">{t(idioma, 'artistas.obra.titulo')}</h2>
      <p class={CLASE_DETALLE}>{fotos.length === 0 ? grupoDeObra : detalleDeObra}</p>
    </div>
    {
      fotos.length > 0 ? (
        <Galeria fotos={fotos} idioma={idioma} />
      ) : (
        <div class="flex flex-col gap-6">
          <div class={CLASE_OBRA_VACIA} data-rotacion style="transform: rotate(-0.5deg)">
            {t(idioma, 'artistas.obra.vacia')}
          </div>
          <p class={CLASE_PENDIENTES}>{t(idioma, 'artistas.obra.vaciaLinea')}</p>
        </div>
      )
    }
  </section>

  {
    alrededor !== undefined && (
      <nav
        aria-label={t(idioma, 'artistas.otros')}
        class="contenedor seccion flex flex-col gap-2 pb-16 md:flex-row md:items-center md:justify-between md:gap-6 md:pb-24"
      >
        <a
          href={rutaLocalizada(`/artistas/${alrededor.anterior.data.slug}`, idioma)}
          class={CLASE_NAV_ENLACE}
        >
          {interpolar(t(idioma, 'artistas.anterior'), { nombre: conNumero(alrededor.anterior) })}
        </a>
        <a
          href={rutaLocalizada(`/artistas/${alrededor.siguiente.data.slug}`, idioma)}
          class={`${CLASE_NAV_ENLACE} self-end md:self-auto`}
        >
          {interpolar(t(idioma, 'artistas.siguiente'), { nombre: conNumero(alrededor.siguiente) })}
        </a>
      </nav>
    )
  }

  {fotos.length > 0 && <Lightbox fotos={fotos} prefijoPie={titular} idioma={idioma} />}
</Pagina>
