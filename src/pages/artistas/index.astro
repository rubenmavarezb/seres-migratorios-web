---
/**
 * `/artistas` — index of the 14 people of the collective (SM-036).
 *
 * OBSERVACIÓN (sitemap vs. lámina aprobada; same precedent `Pagina.astro` and
 * `FichaFotografo.astro` already set: "la lámina aprobada es posterior al
 * backlog y gana"). `sitemap.md` §2.3 — written 06.09.2026 at 01:07 — describes
 * this page as a display "FOTÓGRAFOS" headline, five `CajaNombre` filter tabs
 * (Todos · Fotean · Exponen · Film · Música) over a grid of `FichaFotografo`,
 * a loose `Sello` and a final `Boton`. The design approved later that same day
 * (`design/Artistas.dc.html`, the three screens "Artistas · Desktop",
 * "Artistas · Mobile" and "Fila · estados") shows something else: a handwritten
 * `Anotacion` as the title, and TWO role sections — "Fotean" (`#fotean`) and
 * "Exponen" (`#exponen`) — each one a table-like list of rows. Its "NOTA PARA
 * DESARROLLO" is explicit about the row not being a canonical component
 * ("mismo componente de fila (HTML plano, no hay canónico)"), and
 * `FichaFotografo.astro`'s own header documents that its only web usages are
 * `Home.dc.html` and `Edicion.dc.html`. `Pagina.astro`'s `encabezado` slot was
 * built for this very page ("/artistas (an `Anotacion` as the title,
 * `64px 48px 48px`)"), which is the tech lead already reading the design the
 * same way. This page follows the design.
 *
 * Consequences for SM-036's acceptance criteria, none of them lost:
 * - "el filtro por rol funciona sin JavaScript": the approved design resolves
 *   the filter structurally — each role is its own `<section>` with an `id`
 *   (`#fotean`, `#exponen`), rendered at build time. There is no JavaScript on
 *   this page at all. The five tabs of the sitemap are NOT built: two of them
 *   (`#film`, `#musica`) would need sections no approved screen shows, and
 *   inventing them is not this ticket's call. Adding the tab row later is
 *   additive — the anchors it needs already exist.
 * - "lista las 14 personas, quienes fotean con número 001 a 007 y el resto sin
 *   número": the two groups add up to the 14 entries; Angela Pérez and Leo
 *   Simmons hold both roles and appear in both groups with a single profile,
 *   exactly as the design's `renderVals()` does.
 * - "el orden es estable entre builds": every comparator lives in
 *   `src/orden-artistas.ts` and reads only committed content.
 *
 * OBSERVACIÓN (handles): the design writes "[HANDLE]" for whoever has no
 * confirmed handle and adds "[a confirmar]" next to Pati Caro's and Leo
 * Simmons's. The `artistas` schema has no field for "handle unconfirmed" (only
 * `aliados` has `confirmado`), so the "[a confirmar]" note is not rendered
 * anywhere: it cannot be derived from content and inventing it is worse than
 * omitting it. A handle that IS a bracket placeholder in the collection
 * (Gabriela Rondón, Gustavo Sánchez) renders as the dictionary's generic
 * "[HANDLE]" in grafito and without the link underline — the design's own
 * empty state, and the treatment `FichaFotografo.astro` already gives a
 * placeholder handle. The design's `renderVals()` also shows "[HANDLE]" for
 * Sofía Martín, but the collection has a real handle for her (@sofiafighters):
 * content wins.
 */
import { getCollection } from 'astro:content';

import exponenManuscrita from '../../assets/manuscritas/marca/exponen.png';
import Anotacion from '../../components/Anotacion.astro';
import { rutaLocalizada, t, type Idioma } from '../../i18n/utils.ts';
import Pagina from '../../layouts/Pagina.astro';
import {
  edicionDestacada,
  grupos,
  rolesDeSeccion,
  type Artista,
  type Seccion,
} from '../../orden-artistas.ts';

/** ES-only page: `/en/artists` is Fase 3 (SM-051). */
const idioma: Idioma = 'es';

/** Local stand-in for `t()`'s missing interpolation — same helper as `Sello.astro` and `FichaFotografo.astro`. */
function interpolar(plantilla: string, valores: Record<string, string>): string {
  return Object.entries(valores).reduce(
    (acumulado, [clave, valor]) => acumulado.replaceAll(`{${clave}}`, valor),
    plantilla
  );
}

/** A bracket placeholder is valid content but never a handle to show as a link — same helper as `FichaFotografo.astro`. */
function esPlaceholder(valor: string | undefined): boolean {
  return valor === undefined || /^\[[^\]]+\]$/.test(valor);
}

const artistas = await getCollection('artistas');
const ediciones = await getCollection('ediciones');
const edicion = edicionDestacada(ediciones);
const { fotea, expone } = grupos(artistas, edicion);

/** Row of the list, resolved in the frontmatter so the markup below stays one shape for both sections. */
interface Fila {
  numero: string;
  nombre: string;
  handle: string;
  claseHandle: string;
  rol: string;
  href: string;
}

/**
 * Cell classes live here, not in the markup, for the reason
 * `FichaFotografo.astro` documents at length: with `compressHTML: true` any
 * newline between a tag's `>` and its content renders as a literal space, and
 * prettier splits a tag across three lines as soon as it passes `printWidth`.
 * Short constants keep every cell on one source line, so each grid cell holds
 * exactly its own text.
 */
const CLASE_SUBTITULO = 'font-mono text-etiqueta font-bold text-grafito uppercase';
const CLASE_NUMERO = 'row-span-2 pt-px font-mono text-sm text-grafito md:row-span-1 md:pt-0';
const CLASE_NOMBRE = 'font-mono text-etiqueta font-bold text-tinta uppercase';
const CLASE_ROL =
  'hidden font-mono text-metadatos font-bold tracking-[0.04em] text-grafito uppercase md:block';
const CLASE_HANDLE = 'font-mono text-metadatos md:text-sm';
/** A real handle reads as a link (it is not one: the whole row is the anchor); a placeholder stays grafito, unlinked and unadorned. */
const CLASE_HANDLE_ENLACE =
  'text-azul-sello underline underline-offset-[3px] group-hover:text-azul-marcador';

function aFila(artista: Artista, seccion: Seccion): Fila {
  const { numero, nombre, instagram, slug } = artista.data;
  const pendiente = esPlaceholder(instagram);

  const rol = rolesDeSeccion(artista, seccion)
    .map((rolActual) => {
      const etiqueta = t(idioma, `roles.${rolActual}`);
      // "Fotea · Set 003" only in the group that is about shooting: the design
      // writes plain "Expone · Fotea" in the second one.
      return rolActual === 'fotea' && rolActual === seccion && numero !== undefined
        ? interpolar(t(idioma, 'artistas.rolConSet'), { rol: etiqueta, numero })
        : etiqueta;
    })
    .join(' · ');

  return {
    numero: numero ?? '',
    nombre,
    handle: pendiente ? t(idioma, 'artistas.handlePendiente') : (instagram ?? ''),
    claseHandle: pendiente
      ? `${CLASE_HANDLE} text-grafito`
      : `${CLASE_HANDLE} ${CLASE_HANDLE_ENLACE}`,
    rol,
    href: rutaLocalizada(`/artistas/${slug}`, idioma),
  };
}

const numeros = fotea.map((artista) => artista.data.numero).filter((n) => n !== undefined);
const primerNumero = numeros[0] ?? '';
const ultimoNumero = numeros[numeros.length - 1] ?? '';

const secciones = [
  {
    id: 'fotea',
    titulo: t(idioma, 'artistas.fotean.titulo'),
    detalle:
      numeros.length === 1
        ? interpolar(t(idioma, 'artistas.fotean.detalleUno'), { primero: primerNumero })
        : interpolar(t(idioma, 'artistas.fotean.detalle'), {
            primero: primerNumero,
            ultimo: ultimoNumero,
          }),
    filas: fotea.map((artista) => aFila(artista, 'fotea')),
  },
  {
    id: 'expone',
    titulo: t(idioma, 'artistas.exponen.titulo'),
    detalle:
      expone.length === 1
        ? t(idioma, 'artistas.exponen.detalleUno')
        : interpolar(t(idioma, 'artistas.exponen.detalle'), { cantidad: String(expone.length) }),
    filas: expone.map((artista) => aFila(artista, 'expone')),
  },
].filter((seccion) => seccion.filas.length > 0);

// The design's anchors are `#fotean` / `#exponen` (the verb, plural), not the
// role names of the schema (`fotea` / `expone`).
const ANCLA: Record<string, string> = { fotea: 'fotean', expone: 'exponen' };

/**
 * One `<a>` per row, so the row's four columns are a single click target: the
 * handle inside it is styled as a link but is NOT one (a nested `<a>` is
 * invalid HTML, and the design's row is a single anchor to the profile).
 */
const CLASES_FILA = [
  'group grid min-h-11 grid-cols-[44px_minmax(0,1fr)] items-start gap-x-3 gap-y-1',
  // The 3px left rule only becomes visible on hover, so it is reserved from the
  // start (transparent) and the left padding is 9/13px — 12/16px minus that
  // border — exactly as the design writes it.
  //
  // `box-content` is load-bearing: the design writes `min-height: 56px` (44 on
  // mobile) next to `padding: 14px …` on an element with no `box-sizing`, so
  // the approved row is 56 + 28 = 84px tall (44 + 28 = 72 on mobile, where the
  // two stacked lines already exceed the minimum). Tailwind's preflight makes
  // every element `border-box`, which would collapse the desktop row to a flat
  // 56px — 28px shorter than the screen that was approved. Keeping the
  // authored 56/44 numbers and switching the box model reproduces the geometry
  // without hardcoding the sum.
  'box-content border-l-[3px] border-l-transparent py-3.5 pr-3 pl-[9px] text-tinta transition-colors',
  'hover:border-l-azul-marcador hover:bg-azul-tinta-agua',
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azul-sello',
  'md:min-h-14 md:grid-cols-[64px_minmax(0,1.2fr)_minmax(0,1fr)_132px] md:items-center md:gap-6 md:pr-4 md:pl-[13px]',
].join(' ');
---

<Pagina
  titulo={t(idioma, 'artistas.titulo')}
  descripcion={t(idioma, 'artistas.descripcion')}
  idioma={idioma}
  rutaActual={Astro.url.pathname}
  contenedor={false}
>
  <section
    slot="encabezado"
    class="contenedor flex flex-col items-start gap-3 pt-12 pb-8 md:flex-row md:items-end md:justify-between md:gap-6 md:pt-16 md:pb-12"
  >
    {
      /* The title IS the annotation (design + `Pagina.astro`'s slot doc). `Anotacion` has no size prop, so the size the design asks for — 3.5rem mobile / 5rem desktop, against the component's own `clamp(1.5rem, 4vw, 3rem)` — is scoped as the custom property its `text-manuscrita` utility reads, the same technique `FichaFotografo.astro` uses for the 1.375rem of its quote. */
    }
    <h1 class="[--text-manuscrita:3.5rem] md:[--text-manuscrita:5rem]">
      <Anotacion texto={t(idioma, 'artistas.anotacion')} rotacion={-2} />
    </h1>
    {edicion !== undefined && <p class={CLASE_SUBTITULO}>{edicion.data.nombre}</p>}
  </section>

  {
    secciones.map((seccion, indice) => (
      <section
        id={ANCLA[seccion.id]}
        class:list={[
          'contenedor seccion grilla-4-8 items-start',
          indice === secciones.length - 1 && 'pb-16 md:pb-24',
        ]}
      >
        <div class="flex flex-col items-start gap-2 md:gap-4">
          {seccion.id === 'expone' ? (
            /* The scanned word "exponen" is the section's heading: its `alt` is
               the transcription, so the `<h2>` has a real accessible name. The
               wrapper's `max-w` is what makes the scan 200px on mobile and
               280px on desktop — `Anotacion`'s `ancho` is a single number and
               its inline `max-width: 100%` obeys this box. */
            <h2 class="max-w-[200px] md:max-w-[280px]">
              <Anotacion
                imagen={exponenManuscrita}
                alt={seccion.titulo}
                ancho={280}
                rotacion={-2}
              />
            </h2>
          ) : (
            <h2 class="seccion-titulo">{seccion.titulo}</h2>
          )}
          <p class="font-mono text-metadatos text-grafito">{seccion.detalle}</p>
        </div>

        <ul class="flex flex-col border-t-2 border-tinta">
          {seccion.filas.map((fila) => (
            <li class="border-b border-linea">
              <a href={fila.href} class={CLASES_FILA}>
                <span class={CLASE_NUMERO}>{fila.numero}</span>
                <span class={CLASE_NOMBRE}>{fila.nombre}</span>
                <span class={fila.claseHandle}>{fila.handle}</span>
                <span class={CLASE_ROL}>{fila.rol}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Pagina>
