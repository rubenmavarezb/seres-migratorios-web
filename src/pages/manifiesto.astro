---
/**
 * `/manifiesto` (SM-035) — Spanish route. Shared body in
 * `internos/paginas/Manifiesto.astro` (SM-048); this file only fixes the
 * locale, so the English twin `/en/manifesto` renders the very same body.
 */
import Manifiesto from '../components/internos/paginas/Manifiesto.astro';
import type { Idioma } from '../i18n/utils.ts';

/** Default locale: this route carries no `/en/` prefix. */
const idioma: Idioma = 'es';
---

<Manifiesto idioma={idioma} />
