---
/**
 * English counterpart of the Fase 1 test page (SM-012, updated in SM-013):
 * same layout, same dictionary keys, `en.json` instead of `es.json`. Replaced
 * by the real home page in SM-034.
 *
 * `idioma` is not passed to `Pagina` on purpose: `Base` derives it from
 * `Astro.currentLocale`, and this page is the check that it resolves to `en`.
 * "Seres Migratorios" is a proper name and is never translated.
 */
import Pagina from '../../layouts/Pagina.astro';
import { type Idioma, t } from '../../i18n/utils.ts';

/** This file only ever renders under the `/en/` locale. */
const idioma: Idioma = 'en';
---

<Pagina
  titulo={t(idioma, 'seo.tituloSitio')}
  descripcion={t(idioma, 'seo.descripcionPorDefecto')}
  rutaActual={Astro.url.pathname}
  encabezado={{
    titulo: t(idioma, 'seo.tituloSitio'),
    subtitulo: t(idioma, 'seo.descripcionPorDefecto'),
  }}
  contenedor={false}
/>
