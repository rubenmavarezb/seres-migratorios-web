---
/**
 * English counterpart of the Fase 1 test page (SM-012): same layout, same
 * dictionary keys, `en.json` instead of `es.json`. Replaced by the real home
 * page in SM-034.
 *
 * `idioma` is not passed to `Base` on purpose: the layout derives it from
 * `Astro.currentLocale`, and this page is the check that it resolves to `en`.
 * "Seres Migratorios" is a proper name and is never translated.
 */
import Base from '../../layouts/Base.astro';
import { type Idioma, t } from '../../i18n/utils.ts';

/** This file only ever renders under the `/en/` locale. */
const idioma: Idioma = 'en';
---

<Base
  titulo={t(idioma, 'seo.tituloSitio')}
  descripcion={t(idioma, 'seo.descripcionPorDefecto')}
  rutaActual={Astro.url.pathname}
>
  <div class="contenedor py-12 md:py-16">
    <h1 class="font-display text-display-lg uppercase">{t(idioma, 'seo.tituloSitio')}</h1>
  </div>
</Base>
