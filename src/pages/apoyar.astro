---
/**
 * `/apoyar` (SM-042) — Spanish route. Shared body in
 * `internos/paginas/Apoyar.astro` (SM-048); this file only fixes the locale, so
 * the English twin `/en/support` renders the very same body.
 */
import Apoyar from '../components/internos/paginas/Apoyar.astro';
import type { Idioma } from '../i18n/utils.ts';

/** Default locale: this route carries no `/en/` prefix. */
const idioma: Idioma = 'es';
---

<Apoyar idioma={idioma} />
