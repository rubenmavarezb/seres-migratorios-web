---
/**
 * `/404` (SM-043) — Spanish route, emitted as `dist/404.html`, which Netlify
 * serves for any unknown route. Shared body in
 * `internos/paginas/NoEncontrada.astro` (SM-048); this file only fixes the
 * locale, so the English twin `/en/404` renders the very same body.
 */
import NoEncontrada from '../components/internos/paginas/NoEncontrada.astro';
import type { Idioma } from '../i18n/utils.ts';

/** Default locale: this route carries no `/en/` prefix. */
const idioma: Idioma = 'es';
---

<NoEncontrada idioma={idioma} />
